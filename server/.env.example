# --- Terminus core ---
PORT=3300
# Shared secret. The Android app sends this in its Cloud Sync "API key" field.
# Leave empty for localhost/Termux-only use; REQUIRED before exposing to the internet.
TERMINUS_API_KEY=

# Where local state snapshots are written before Drive archiving.
DATA_DIR=./data

# --- Brain chain (best reachable core wins) ---
# Tier 1: local Ollama. On the phone this is the Termux daemon. Needs GBs of RAM.
OLLAMA_URL=http://127.0.0.1:11434
# Tier 2: Groq — FREE, NO CARD. Just an email at https://console.groq.com/keys
# Fast enough that she never "times out" like a small phone model. This is how
# you run her without a big box (no local Ollama needed).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Tier 3: Gemini — FREE, NO CARD. Key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Tier 4: Claude — optional, paid. Key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Sub-agents (optional) ---
# A SECOND Terminus she delegates tasks to, so sub-agents never slow her main
# brain. Point it at another Terminus instance (e.g. a free host). Her brain is
# the priority — if this is unset, spawn_subagent politely declines.
SUBAGENT_BRAIN_URL=
SUBAGENT_API_KEY=

# --- Early Warning System link (Kortana feeds CampLoJack) ---
# Where her ews_report tool posts heard dispatches. Point at CampLoJack's scanner
# endpoint (the self-hosted server's /api/scanner). INTERNAL_NOTIFY_KEY must MATCH
# the value CampLoJack uses.
EWS_SCANNER_URL=https://camplojack-server.fly.dev/api/scanner
INTERNAL_NOTIFY_KEY=

# --- Google Drive archive (the 5TB Google One on a.i.intergrated.services@gmail.com) ---
# 1. Create an OAuth client (Desktop app) at https://console.cloud.google.com/apis/credentials
#    and enable the Google Drive API for the project.
# 2. Run `npm run auth` and sign in AS a.i.intergrated.services@gmail.com.
# 3. Paste the printed refresh token below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Root folder name created in that Drive:
DRIVE_ROOT_FOLDER=Kortana
