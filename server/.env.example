# --- Terminus core ---
PORT=3300
# Shared secret. The Android app sends this in its Cloud Sync "API key" field.
# Leave empty for localhost/Termux-only use; REQUIRED before exposing to the internet.
TERMINUS_API_KEY=

# Where local state snapshots are written before Drive archiving.
DATA_DIR=./data

# --- Brain chain (best reachable core wins) ---
# Tier 1: local Ollama. On the phone this is the Termux daemon. Needs GBs of RAM.
OLLAMA_URL=http://127.0.0.1:11434
# Tier 2: Groq — FREE, NO CARD. Just an email at https://console.groq.com/keys
# Fast enough that she never "times out" like a small phone model. This is how
# you run her without a big box (no local Ollama needed).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Tier 3: Cerebras — wired in code, but verified 2026-07-27 that Cerebras now
# gates ALL models behind billing (402 payment_required) even with a key —
# contributes zero free capacity currently. Harmless to leave set; don't rely
# on it. Key at https://console.cerebras.ai if you want to check again later.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Tier 4: Mistral AI — FREE, NO CARD, independent quota. Key ("La Plateforme"
# free tier) at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Tier 5: SambaNova Cloud — FREE, NO CARD, independent quota, fast. Key at
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Tier 5.5: OpenRouter — FREE ":free"-suffixed models, independent quota,
# no card. Key at https://openrouter.ai/keys. Wired into the code already;
# genuinely inactive (real no-op, not broken) until this key is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tier 5.75: NVIDIA NIM — FREE, NO CARD, independent quota, ~40 requests/min
# per model (best-effort, not a hard guarantee). 100+ hosted models at
# https://build.nvidia.com/models; sign up + generate a key at
# https://build.nvidia.com (email verify only, key valid ~6 months). Wired
# into the code already; genuinely inactive (real no-op) until this key is
# set. If NVIDIA_MODEL ever 404s (catalog changes over time), pick a live
# model slug from the build.nvidia.com catalog — no code change needed.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Tier 5.85: Hugging Face Inference Providers — FREE tier for logged-in
# users, no card, ONE token routes to a whole catalog of providers (Cerebras,
# Groq, Together, Fireworks, Novita, DeepInfra, and more) behind hundreds of
# hosted models. Fine-grained token with "Make calls to Inference Providers"
# at https://huggingface.co/settings/tokens. Model id takes an optional
# ":policy" suffix — ":fastest" (default) auto-picks the highest-throughput
# live provider; ":cheapest" or a specific provider name (e.g. ":groq") also
# work. Wired into the code already; genuinely inactive (real no-op) until
# this token is set.
HF_TOKEN=
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
# Tier 6: Gemini — FREE, NO CARD. Key at https://aistudio.google.com/apikey
# Use the '-latest' alias, not a dated model name — Google deprecates those
# (gemini-2.0-flash/2.5-flash have 404'd) and a dead model silently kills this
# tier without you noticing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tier 7: Claude — paid, but no free-tier ceiling. Key at console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Tier 8: OpenAI — paid, no free tier, same priority as Claude (tried last,
# after every free core). Key at platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Sub-agents / the SECONDARY BRAIN POOL (optional) ---
# One OR MORE extra Terminus instances she delegates to, so sub-agents never
# slow her main brain. COMMA-SEPARATED for a pool — that's what lets `supervise`
# fan sub-agents across SEVERAL independent brains at once, and lets her run one
# supervisor per directive each pinned to its own brain (supervise's `brain`
# arg), so several directives never contend on one brain. Her main brain stays
# the priority — if this is unset, spawn_subagent/supervise decline honestly.
#
# PHONE (Termux) is fine for this: each pool brain is dedicated to a CLOUD
# provider (below), so it's a light Node process (~tens of MB), NOT a model in
# RAM. Three or four run comfortably alongside your main brain; only the main
# brain optionally carries Ollama. Stand the pool up daemonized with PM2:
#   bash server/deploy/fire-up-brains.sh      # or: pm2 start server/ecosystem.brains.config.js
# (docker `--profile pool` and the systemd template are for a VPS, not the phone.)
# The launcher prints the exact line below, listing ONLY the brains that came up
# functional.
#
# A brain with no working core (no key, no Ollama) still boots but is skipped at
# runtime: supervise health-checks /health and refuses to pin to, or round-robin
# onto, a brain that isn't genuinely live. So an unlit slot here costs nothing.
SUBAGENT_BRAIN_URL=
# Example once the pool is up on the phone (6 brains: main + 5 sub-agent brains):
# SUBAGENT_BRAIN_URL=http://127.0.0.1:3301,http://127.0.0.1:3302,http://127.0.0.1:3303,http://127.0.0.1:3304,http://127.0.0.1:3305
SUBAGENT_API_KEY=
#
# How many sub-agents `supervise` runs AT ONCE. On a phone, firing every pool
# brain simultaneously (plus a local model resident in RAM) spikes memory and
# Android OOM-kills Termux mid-answer — so the fan-out runs in small batches.
# Default 2 is phone-safe; raise it on a real server with RAM to spare.
SWARM_MAX_CONCURRENCY=2
#
# --- Local model (Ollama) memory hold ---
# How long Ollama keeps the model resident after a turn. Long holds avoid
# reload latency but pin ~2GB in RAM — on a phone that's what tips a swarm into
# an OOM. Default is short ('5m'); set '30m' only where RAM is plentiful.
OLLAMA_KEEP_ALIVE=5m

# --- Per-instance brain dedication (only meaningful on a POOL instance) ---
# Leave BLANK here on the main brain — it uses the full fallback chain. A pool
# instance sets this PER-PROCESS (ecosystem.brains.config.js / the compose pool /
# a systemd drop-in), NOT in this shared file: TERMINUS_CORE pins which provider
# LEADS that instance so the pool spreads across INDEPENDENT free quotas —
# groq | gemini | mistral | sambanova | openrouter | nvidia | huggingface |
# cerebras | ollama | claude | openai. The rest of the chain still backs it up so
# a dedicated brain never goes silent. TERMINUS_CORE_ONLY=1 = strict single
# provider (no fallback). All pool instances still read this same .env for the
# actual keys; only which core leads differs per process.
TERMINUS_CORE=
TERMINUS_CORE_ONLY=

# --- Early Warning System link (Kortana feeds CampLoJack) ---
# Where her ews_report tool posts heard dispatches. Points at CampLoJack's free
# Vercel scanner endpoint, which geocodes the dispatch and proximity-pushes every
# nearby subscriber. INTERNAL_NOTIFY_KEY must MATCH the value set in CampLoJack's
# Vercel env vars (that's the shared secret that authorizes the post).
EWS_SCANNER_URL=https://theinvisiblepeople.org/api/ews-alerts?action=scanner
INTERNAL_NOTIFY_KEY=

# --- Google Drive archive (the 5TB Google One on a.i.intergrated.services@gmail.com) ---
# This is her permanent memory. Without it she only remembers what's on the
# host's local disk — and on a free host (Render) that disk is wiped on every
# restart, so she forgets. With it, her state/memories/chats/scripts land in
# your 5TB and survive anything.
#
# Setup (once — uses the reliable phone-friendly DEVICE FLOW, no localhost port):
# 1. console.cloud.google.com -> APIs & Services -> enable "Google Drive API".
# 2. Credentials -> Create OAuth client ID -> type "TV and Limited Input devices"
#    (NOT "Desktop app" — device flow needs this type). Copy its ID + secret here.
# 3. If the consent screen is in "Testing", add a.i.intergrated.services@gmail.com
#    as a Test user.
# 4. cd ~/k3/server && npm run auth  -> open the URL, type the code, sign in AS
#    a.i.intergrated.services@gmail.com, approve. It prints GOOGLE_REFRESH_TOKEN.
# 5. Put all three below AND in the Render dashboard env vars, then restart her.
#    /health then shows "drive":{"enabled":true}.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Root folder name created in that Drive:
DRIVE_ROOT_FOLDER=Kortana
